# ==================================================
# VOLTERA BACKEND - ENVIRONMENT CONFIGURATION
# ==================================================

# Server Port
PORT=3000

# Application Environment (development, test, production)
APP_ENV=development

# Database Connection URL
# SQLite Example (Local Development / Testing):
DATABASE_URL="file:./dev.db"

# PostgreSQL Example:
# DATABASE_URL="postgresql://user:password@localhost:5432/voltera_db?schema=public"

# MySQL Example:
# DATABASE_URL="mysql://user:password@localhost:3306/voltera_db"

# Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# CORS Allowed Origins
CORS_ORIGIN="*"

# JWT Authentication Configuration
JWT_SECRET="voltera-super-secret-jwt-key-minimum-32-chars-long"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_SECRET="voltera-super-secret-refresh-token-key-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# OTP Security Configuration
OTP_TTL_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_PROVIDER="console" # Options: console, mock, twilio
OTP_API_KEY=""
OTP_SENDER_ID=""

# Payment Configuration
PAYMENT_PROVIDER="mock" # Options: mock, razorpay
PAYMENT_API_KEY=""
PAYMENT_API_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Platform Fee (Percentage deducted from provider earnings)
PLATFORM_FEE_PERCENTAGE=10

# Push Notifications (FCM / Firebase Cloud Messaging)
PUSH_PROVIDER="mock" # Options: mock, fcm
FCM_SERVER_KEY="" # Required if PUSH_PROVIDER=fcm
